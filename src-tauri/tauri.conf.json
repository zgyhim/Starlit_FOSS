{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "星伴",
  "version": "0.1.0",
  "identifier": "org.starlitfoss.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "星伴",
        "width": 1380,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../resources/template",
      "../resources/media"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
